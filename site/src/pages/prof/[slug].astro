---
import Base from '../../layouts/Base.astro';
import ProfThisTerm from '../../components/prof/ProfThisTerm.astro';
import ProfPastTerms from '../../components/prof/ProfPastTerms.astro';
import { courseCountText } from '../../components/prof/profText';
import { codeLabel, dataMeta } from '../../lib/data';
import { getProfessorBySlug, getProfessors } from '../../lib/data/professors';

export function getStaticPaths() {
  return getProfessors().map((p) => ({ params: { slug: p.slug } }));
}

const prof = getProfessorBySlug(Astro.params.slug!)!;
const nowCourses = prof.courses.filter((c) => c.nowSections.length > 0);
const status = prof.teachingNow ? `Teaching ${courseCountText(nowCourses.length)} this term` : `Last taught ${prof.lastTerm}`;
const codes = prof.courses.slice(0, 8).map((c) => codeLabel(c.code));
const more = prof.courses.length - codes.length;
const description = `Courses taught by ${prof.name} at SMU: ${codes.join(', ')}${more > 0 ? ` and ${more} more` : ''}. Past bid results for each course with this professor.`;
---
<Base title={`${prof.name} · Bidwise`} description={description} windowPicker={false} active="search">
  <header>
    <h1>{prof.name}</h1>
    <p class="status">{status}</p>
    <p class="taught">Courses taught:
      {prof.courses.map((c) => <a href={`/course/${c.code}/`} title={c.title}>{codeLabel(c.code)}</a>)}
    </p>
  </header>
  {prof.teachingNow && <ProfThisTerm courses={nowCourses} term={dataMeta.currentTerm} />}
  {prof.pastTerms.length > 0 && <ProfPastTerms terms={prof.pastTerms} courses={prof.courses} />}
  <p class="note">A section taught by more than one professor appears on each profile.</p>
</Base>

<style>
  header { padding-bottom: var(--s2); }
  h1 { font-size: 30px; font-weight: 600; }
  p { margin: 0; }
  .status { margin-top: var(--s1); color: var(--muted); font-size: 17px; }
  .taught { margin-top: var(--s3); font-size: var(--fs-sm); color: var(--muted); display: flex; flex-wrap: wrap; gap: 0 var(--s3); align-items: center; }
  .taught a { display: inline-flex; align-items: center; min-height: 32px; color: var(--accent); font-weight: 600; text-decoration: none; }
  .taught a:hover { text-decoration: underline; }
  .note { margin-top: var(--s5); color: var(--muted); font-size: var(--fs-xs); }
</style>
