---
import Base from '../../layouts/Base.astro';
import CourseView from '../../components/course/CourseView.svelte';
import RecordView from '../../components/RecordView.svelte';
import ResultsNotice from '../../components/ResultsNotice.svelte';
import Requisites from '../../components/course/Requisites.svelte';
import { bossCodeOf, dataMeta, getCourseIndex, getForecastMeta, getWindow, splitSibling, windowLabel } from '../../lib/data';
import { getCourse } from '../../lib/data/server';
import { buildRowSeed } from '../../components/course/rowSeed';
import { DEFAULT_STYLE } from '../../lib/sim/presets';
import { readRequisites } from '../../lib/requisites/server';
import { buildRows, catalogueNote } from '../../lib/requisites/render';
import { hasOutline } from '../../lib/data/outlines';
import { courseDataset, courseDescription, courseFacts } from '../../lib/courseFacts';

export function getStaticPaths() {
  return getCourseIndex().map((c) => ({ params: { code: c.code } }));
}

const windowName = windowLabel(getWindow());
const course = getCourse(Astro.params.code!)!;
const facts = courseFacts(course.history);
// Pages show the BOSS code; a split course (COR-STAT1202-X) is told apart by its title. The site code stays in the URL and the data.
const shownCode = bossCodeOf(course.code, course.bossCode);
const description = courseDescription(shownCode, course.title, facts, 'course', course.sectionsNow.length);
const pageUrl = new URL(`/course/${course.code}/`, Astro.site).href;
// Only this term's sections go into the page, without forecast parameters; history and parameters are fetched by the island.
const sections = course.sectionsNow.map(({ forecast: _f, ...s }) => s);
const forecastMeta = getForecastMeta();
// Each open section's bid and chance for the build's window, simulated here so they are in the HTML (CourseView uses them while they still apply).
const rowSeed = await buildRowSeed(course.sectionsNow, forecastMeta.windows, windowName, DEFAULT_STYLE);
// Requisite rows are rendered here, so the island only gets small, finished props. No data file or no entry: no block.
// Requisites are filed under the BOSS code, so a split site course (COR-STAT1202-X) reads its BOSS course's entry.
const bossCode = bossCodeOf(course.code, course.bossCode);
const reqData = readRequisites();
const reqEntry = reqData ? (reqData.courses[course.code] ?? reqData.courses[bossCode]) : undefined;
const reqRows = reqData
  ? buildRows(reqEntry, { siteKeys: new Set(getCourseIndex().map((c) => c.code)), names: reqData.names, asOf: reqData.asOf })
  : [];
const reqNote = reqData && reqRows.length ? catalogueNote(reqEntry, reqData.asOf) : [];
// A course split into two site pages (Rosie Ching's SMU-X statistics sections) says how the two relate.
const outlineHref = hasOutline(course.code) ? `/course/${course.code}/outline/` : null;
const siblingCode = splitSibling(course.code);
const sibling = siblingCode ? getCourseIndex().find((c) => c.code === siblingCode) : undefined;
const splitNote = sibling
  ? bossCode !== course.code
    ? { lead: 'Same BOSS course as ', link: `${bossCode} (${sibling.title})`, mid: ', listed separately here.', to: sibling.code }
    : { lead: `Rosie Ching's SMU-X sections are listed separately: `, link: sibling.title, mid: '', to: sibling.code }
  : null;
---
<Base title={`${bossCode !== course.code ? `${bossCode} ${course.title}` : bossCode} · Bidwise`} description={description} jsonLd={facts ? [courseDataset(shownCode, course.title, description, pageUrl, facts, `${Astro.site}`)] : []} active="search">
  <header>
    <h1>{shownCode}</h1>
    <p>{course.title}</p>
    {outlineHref && <a class="outlink" href={outlineHref}>Course outlines ›</a>}
    {splitNote && <p class="split">{splitNote.lead}<a href={`/course/${splitNote.to}/`}>{splitNote.link}</a>{splitNote.mid}</p>}
  </header>
  {reqRows.length > 0 && <Requisites client:idle rows={reqRows} note={reqNote} />}
  <!-- A visitor who chose another window sees "Calculating" in the seeded cells until the page has recomputed (CourseView removes the class). -->
  <script is:inline define:vars={{ seedWindow: rowSeed.window }}>
    try {
      var chosen = localStorage.getItem('boss.window');
      if (chosen && chosen !== seedWindow) document.documentElement.classList.add('seed-off');
    } catch (e) {}
  </script>
  <RecordView client:load code={course.code} />
  <ResultsNotice partial={dataMeta.resultsPartial ?? null} />
  <CourseView client:load code={course.code} bossCode={bossCode} title={course.title} sections={sections} {windowName} currentTerm={dataMeta.currentTerm} latestWindow={dataMeta.latestResultsWindow} resultsPartial={dataMeta.resultsPartial ?? null} openScanAt={dataMeta.seats?.openScanAt ?? null} prevScanAt={dataMeta.seats?.prevScanAt ?? null} {forecastMeta} {rowSeed} />
</Base>

<style>
  header { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 var(--s3); padding-bottom: var(--s3); }
  h1 { font-size: 30px; font-weight: 600; }
  p { margin: 0; color: var(--muted); font-size: 17px; }
  .split { flex-basis: 100%; margin-top: var(--s1); font-size: 15px; }
  .split a { color: var(--accent); }
  .outlink { display: inline-flex; align-items: center; min-height: 44px; margin-left: auto; font-size: 15px; font-weight: 600; color: var(--accent); text-decoration: none; }
  .outlink:hover { text-decoration: underline; }
</style>
