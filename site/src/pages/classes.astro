---
import Base from '../layouts/Base.astro';
---
<Base title="Browse · Bidwise" active="explore" windowPicker={false}>
  <p class="go"><a class="btn" href="/explore/">Open Browse</a></p>
</Base>

<script>
  // Classes is now part of Browse: carry the old filters over.
  import { classesQueryToBrowse } from '../components/explore/courses';
  const qs = classesQueryToBrowse(location.search);
  location.replace(`/explore/${qs ? `?${qs}` : ''}`);
</script>

<style>
  .go { margin: 0; }
</style>
