# Public repo allowlist: only the site, the model and its docs and tests are published.
# Everything at the root is ignored, then these are re-included. (pyproject.toml is for other tooling, so it stays out.)
/*
!/.gitignore
!/README.md
!/site/
!/model/
!/docs/
!/tests/
# tests/: only the model and site-data tests and their synthetic fixtures.
/tests/*
!/tests/test_forecast_fit.py
!/tests/test_forecast_sim.py
!/tests/test_build_site_data.py
!/tests/test_site_data_s1.py
!/tests/fixtures/
/tests/fixtures/*
!/tests/fixtures/site_data_fixture.csv
!/tests/fixtures/forecast_sim_parity.json
!/tests/fixtures/forecast_sim_parity_gen.ts

# Local data and rebuildable outputs.
/data/

# Python environments, caches, and generated bytecode.
/.cache/
/.venv/
/venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Local machine metadata.
.DS_Store

# Private handover notes for this local project.
.local-handover/

# Keep the repo to code only (owner rule 2026-11-07): no data, backups, logs or generated outputs.
*.bak*
*.sqlite
*.sqlite3
*.db
*.xls
*.xlsx
*.webarchive
*.evidence.txt
*.log
*.jsonl
.env
.env.*
# Generated from the private dataset by build_site_data.py / model.forecast.fit; deployed as built site output, never committed.
/site/src/data/real/
/model/forecast/out*/
# Agent instructions and handovers stay local.
CLAUDE.md
AGENTS.md
# Local site builds, the live pointer and swapped site data.
/site/builds/
/site/live
/site/src/data/real.prev-*
/site/src/data/real.new-*
# Local deploy switch.
/config/deploy.json

# Local agent tooling and any CSV data; the one synthetic test fixture is re-included last so it wins.
.claude/
*.csv
!/tests/fixtures/site_data_fixture.csv
