---
import Base from '../layouts/Base.astro';
import Search from '../components/Search.svelte';
import Countdown from '../components/home/Countdown.svelte';
import { getSearchIndex, getSchedule, windowLabel } from '../lib/data';
import { PLANNER_ENABLED } from '../lib/flags';

const index = getSearchIndex();
// All window times are SGT with an explicit offset; the component picks the state in the browser (this is only the build-time fallback).
const windows = getSchedule().map((s) => ({ label: windowLabel(s), opensAt: s.opensAt, closesAt: s.closesAt }));
const builtAt = Date.now();
---
<Base title="Courses · Bidwise" active="search">
  <div class="home">
    <div class="lead">
      <h1>How much should I bid?</h1>
      <div class="find"><Search client:load index={index} /></div>
      <div class="status">
        <Countdown client:load windows={windows} builtAt={builtAt} />
      </div>
    </div>
    <nav class="paths" aria-label="More">
      {PLANNER_ENABLED && <a class="btn big" href="/planner/">Plan for multiple courses</a>}
      <a class="btn big" href="/plan-b/">Missed a bid? Find a Plan B</a>
      <a class="btn big" href="/method/">How does it work?</a>
      <a class="btn big" href="/swap/">Swap a section</a>
    </nav>
  </div>
</Base>

<style>
  .home { width: 100%; max-width: 680px; margin: 0 auto; display: grid; gap: var(--s4); justify-items: stretch; padding-top: var(--s4); }
  .lead { display: contents; }
  .status { order: 2; display: grid; justify-items: center; text-align: center; }
  .paths { order: 1; }
  h1 { font-size: var(--fs-xl); font-weight: 600; line-height: 1.15; text-align: center; }
  .find { min-width: 0; }
  .home :global(label.find) {
    position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; border: 0;
    overflow: hidden; clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap;
  }
  .paths { display: grid; gap: var(--s2); }
  .big { min-height: 52px; flex-direction: column; gap: 0; text-align: center; }
  .big small { font-size: var(--fs-xs); font-weight: 400; }
  @media (max-width: 767px) {
    /* Fill the visible area between header and tab bar: empty top row, lead centred in the middle row, buttons at the bottom. */
    .home {
      min-height: calc(100dvh - var(--topbar-h) - var(--s5) - var(--tabbar-h) - env(safe-area-inset-bottom) - 16px);
      grid-template-rows: 1fr auto 1fr;
      gap: 0; padding-top: 0;
      /* Pushes the footer below the tab bar, so it starts below the fold. */
      margin-bottom: calc(var(--tabbar-h) + var(--s5));
    }
    .lead { display: grid; gap: var(--s4); grid-row: 2; }
    .paths { grid-row: 3; align-self: end; }
  }
  @media (min-width: 768px) {
    .paths { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1024px) {
    .home { padding-top: 12vh; gap: var(--s5); }
    h1 { font-size: var(--fs-hero); }
  }
</style>
