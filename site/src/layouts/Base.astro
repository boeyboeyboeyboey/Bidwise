---
import '../styles/global.css';
import { getWindow, getSchedule, windowLabel, getForecastMeta } from '../lib/data';
import { PLANNER_ENABLED } from '../lib/flags';
import { GITHUB_URL, LINKEDIN_URL, GITHUB_ICON, LINKEDIN_ICON } from '../lib/links';

interface Props {
  title?: string;
  active?: 'search' | 'explore' | 'planner' | 'planb' | 'swap' | 'schedule' | 'method';
  /** The header's bidding-window select; off on pages that don't use it. */
  windowPicker?: boolean;
  /** 'text': centred reading column (about 1000 px of content); 'wide' (default): full width. Both keep the same side padding. */
  width?: 'text' | 'wide';
}
const { title = 'Bidwise', active, windowPicker = true, width = 'wide' } = Astro.props;
const openLabel = windowLabel(getWindow());
const openStatus = getWindow().status;
// Read in the browser by lib/data/window.ts, which re-picks the window against the clock.
const winData = JSON.stringify({ schedule: getSchedule(), configured: getWindow() }).replace(/</g, '\\u003c');
const tagFor = (s: string) => (s === 'open' ? ' (open now)' : s === 'upcoming' ? ' (next)' : '');
const windows = getForecastMeta().windows;
const choices = windows.includes(openLabel) ? windows : [openLabel, ...windows];
const allTabs = [
  { id: 'search', href: '/', label: 'Courses', icon: 'M11 4a7 7 0 1 0 4.2 12.6l4.1 4.1 1.4-1.4-4.1-4.1A7 7 0 0 0 11 4Zm0 2a5 5 0 1 1 0 10 5 5 0 0 1 0-10Z' },
  { id: 'explore', href: '/explore/', label: 'Browse', icon: 'M4 5h2v2H4V5Zm4 0h12v2H8V5Zm-4 6h2v2H4v-2Zm4 0h12v2H8v-2Zm-4 6h2v2H4v-2Zm4 0h12v2H8v-2Z' },
  { id: 'planner', href: '/planner', label: 'Bid planner', short: 'Planner', icon: 'M5 4h14a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1Zm1 2v12h12V6H6Zm2 2h8v2H8V8Zm0 4h8v2H8v-2Z' },
  { id: 'planb', href: '/plan-b/', label: 'Plan B', icon: 'M6 3a3 3 0 0 1 1 5.8V11a3 3 0 0 0 3 3h4.2A3 3 0 1 1 14.2 16H10a5 5 0 0 1-3-1v1.2a3 3 0 1 1-2 0V8.8A3 3 0 0 1 6 3Zm0 2a1 1 0 1 0 0 2 1 1 0 0 0 0-2Zm0 14a1 1 0 1 0 0 2 1 1 0 0 0 0-2Zm11-5a1 1 0 1 0 0 2 1 1 0 0 0 0-2Z' },
  { id: 'swap', href: '/swap/', label: 'Swap', icon: 'M7 3 3 7l4 4V8h8V6H7V3Zm10 10v3H9v2h8v3l4-4-4-4Z' },
  { id: 'schedule', href: '/schedule/', label: 'Schedule', icon: 'M7 2h2v2h6V2h2v2h3a1 1 0 0 1 1 1v15a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h3V2Zm-2 6v11h14V8H5Zm2 2h4v4H7v-4Z' },
] as const;
const tabs = allTabs.filter((t) => PLANNER_ENABLED || t.id !== 'planner');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="top">
      <div class="top-inner">
        <a class="brand" href="/" aria-label="Bidwise home">Bidwise</a>
        <nav class="desk-nav" aria-label="Main">
          {tabs.map((t) => (
            <a href={t.href} aria-current={active === t.id ? 'page' : undefined}>{t.label}{t.id === 'planner' && <span class="plan-badge" hidden></span>}</a>
          ))}
        </nav>
        <div class="hdr-right">
          {windowPicker && (
          <label class="winpick">
            <select id="win-pick" data-open={openLabel} aria-label="Bidding window">
              {choices.map((w) => <option value={w} selected={w === openLabel}>{w === openLabel ? `${w}${tagFor(openStatus)}` : w}</option>)}
            </select>
          </label>
          )}
        </div>
      </div>
    </header>

    <main id="main" tabindex="-1" data-width={width}>
      <slot />
      <footer class="sitefoot">
        <p class="foot-line"><span>Not affiliated with SMU</span><span>Data: BOSS Overall Results, Nov 2026</span></p>
        <p class="foot-line"><a href="/method">How it works</a><a href="/contact">Contact</a>{LINKEDIN_URL && (<a class="ext" href={LINKEDIN_URL} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={LINKEDIN_ICON} /></svg>LinkedIn</a>)}{GITHUB_URL !== 'https://github.com/' && (<a class="ext" href={GITHUB_URL} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={GITHUB_ICON} /></svg>Source code</a>)}</p>
      </footer>
    </main>

    {active !== 'method' && (
    <a class:list={['helpfab', { 'on-home': Astro.url.pathname === '/', 'on-planner': Astro.url.pathname.startsWith('/planner') }]} href="/method/" aria-label="How it works">
      <svg viewBox="0 0 18 18" width="18" height="18" aria-hidden="true"><circle cx="9" cy="9" r="8" fill="none" stroke="currentColor" stroke-width="1.25" /><path d="M6.9 7.1a2.1 2.1 0 1 1 3 1.9c-.6.3-.9.7-.9 1.3v.2" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" /><circle cx="9" cy="12.9" r=".9" fill="currentColor" /></svg>
      <span>How it works</span>
    </a>
    )}

    <nav class="tabbar" aria-label="Main" style={`--tabs:${tabs.length}`}>
      {tabs.map((t) => (
        <a href={t.href} aria-current={active === t.id ? 'page' : undefined}>
          <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d={t.icon} fill="currentColor" fill-rule="evenodd" /></svg>
          <span>{'short' in t ? t.short : t.label}</span>
          {t.id === 'planner' && <span class="plan-badge" hidden></span>}
        </a>
      ))}
    </nav>
    <script type="application/json" id="win-data" set:html={winData}></script>
    <script>
      import { getChosenWindow, setChosenWindow, onWindowChange } from '../lib/state';
      import { liveWindow } from '../lib/data/window';
      const pick = document.getElementById('win-pick') as HTMLSelectElement | null;
      if (pick) {
        // The default is the window that is open now, or the next to open; a stale page re-picks it from the clock.
        let open = pick.dataset.open ?? '';
        const live = liveWindow();
        if (live) {
          open = `Round ${live.round} Window ${live.window}`;
          if (![...pick.options].some((o) => o.value === open)) pick.add(new Option(open, open), pick.options[0]);
        }
        const tags = { open: ' (open now)', upcoming: ' (next)', closed: '' };
        if (live) for (const o of pick.options) o.textContent = o.value === open ? o.value + tags[live.status] : o.value;
        const has = (v: string | null): v is string => !!v && [...pick.options].some((o) => o.value === v);
        const show = (v: string | null) => { pick.value = has(v) ? v : open; };
        show(getChosenWindow());
        pick.addEventListener('change', () => setChosenWindow(pick.value === open ? null : pick.value));
        onWindowChange(show);
      }
    </script>
    <script is:inline>
      (function () {
        function count() {
          var n = 0;
          try {
            var st = JSON.parse(localStorage.getItem('boss.planner') || 'null');
            if (st && Array.isArray(st.r)) n += st.r.length;
          } catch (e) {}
          try {
            var l = JSON.parse(localStorage.getItem('boss.plan') || 'null');
            if (Array.isArray(l)) n += l.length;
          } catch (e) {}
          return n;
        }
        function update() {
          var n = count();
          document.querySelectorAll('.plan-badge').forEach(function (b) {
            b.textContent = String(n);
            b.hidden = n === 0;
            b.setAttribute('aria-hidden', 'true');
            var a = b.parentElement;
            if (a) {
              if (n === 0) a.removeAttribute('aria-label');
              else a.setAttribute('aria-label', 'Bid planner, ' + n + (n === 1 ? ' course' : ' courses'));
            }
          });
        }
        update();
        window.addEventListener('plan-change', update);
        window.addEventListener('storage', update);
      })();
    </script>
  </body>
</html>

<style is:global>
  .top {
    position: sticky; top: 0; z-index: 10;
    background: var(--bg);
    border-bottom: 1px solid var(--rule);
    padding-top: env(safe-area-inset-top);
  }
  .skip {
    position: absolute; left: var(--s2); top: var(--s2); z-index: 20;
    padding: var(--s3) var(--s4); font-weight: 600; text-decoration: none;
    color: var(--accent-ink); background: var(--accent); border-radius: var(--r-md);
    transform: translateY(-200%);
  }
  .skip:focus { transform: none; outline: 2px solid var(--focus); outline-offset: 2px; }
  main:focus { outline: none; }
  .top-inner {
    max-width: var(--maxw); margin: 0 auto;
    min-height: var(--topbar-h);
    padding: var(--s2) var(--gutter);
    display: flex; flex-wrap: wrap; align-items: center; gap: var(--s2);
    justify-content: space-between;
  }
  .brand { font-family: var(--font); font-weight: 700; font-size: 21px; letter-spacing: -0.035em; color: var(--accent); text-decoration: none; display: inline-flex; align-items: center; min-height: 44px; white-space: nowrap; }
  .hdr-right { display: flex; align-items: center; justify-content: flex-end; gap: var(--s2); min-width: 0; margin-left: auto; flex: 1 1 232px; }
  .winpick { display: flex; align-items: center; gap: var(--s2); font-size: 14px; color: var(--muted); min-width: 0; flex: 1 1 auto; }
  .winpick select { min-width: 0; width: 100%; height: 44px; font-size: 13px; padding-right: 32px; padding-left: 10px; background-position: right 8px center; text-overflow: ellipsis; }
  .helpfab {
    position: fixed; z-index: 15;
    right: calc(var(--s4) + env(safe-area-inset-right)); bottom: calc(var(--tabbar-h) + 12px + env(safe-area-inset-bottom));
    width: 44px; height: 44px; display: inline-flex; align-items: center; justify-content: center; gap: var(--s2);
    border: 1px solid var(--rule-strong); border-radius: 999px; background: var(--surface); color: var(--text);
    font-size: var(--fs-sm); font-weight: 500; line-height: 1; text-decoration: none; white-space: nowrap;
    box-shadow: 0 1px 2px rgba(0, 0, 0, .06), 0 4px 12px rgba(0, 0, 0, .06);
    transition: color .15s, border-color .15s;
  }
  /* On a phone the round help button would cover page controls (the home Swap button, the planner's add-alternative button); the footer links to the same page. */
  .helpfab.on-home, .helpfab.on-planner { display: none; }
  .helpfab svg { flex: none; }
  .helpfab span { display: none; }
  .helpfab:hover { color: var(--accent); border-color: var(--accent); }
  .helpfab:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  /* The planner's phone summary bar sits just above the tab bar; stack the button over it. */
  body:has(.planner.has-bar) .helpfab { bottom: calc(var(--tabbar-h) + 45px + 12px + env(safe-area-inset-bottom)); }
  @media (prefers-reduced-motion: reduce) { .helpfab { transition: none; } }
  @media print { .helpfab { display: none !important; } }
  .desk-nav { display: none; gap: var(--s5); margin-left: auto; }
  .desk-nav a {
    text-decoration: none; color: var(--muted); font-weight: 600;
    display: inline-flex; align-items: center; min-height: 44px; border-bottom: 2px solid transparent; white-space: nowrap;
  }
  .desk-nav a:hover { color: var(--text); }
  .desk-nav a[aria-current='page'] { color: var(--accent); border-bottom-color: var(--accent); }

  body { min-height: calc(100dvh / var(--z)); display: flex; flex-direction: column; }
  main {
    flex: 1; width: 100%; display: flex; flex-direction: column;
    max-width: var(--maxw); margin: 0 auto;
    padding: var(--s5) var(--gutter) calc(var(--tabbar-h) + 88px + env(safe-area-inset-bottom));
  }
  main[data-width='text'] { max-width: calc(1000px + 2 * var(--gutter)); }
  main > :nth-last-child(2) { margin-bottom: var(--s6); }
  .sitefoot .ext { white-space: nowrap; display: inline-flex; align-items: center; gap: 4px; }
  .sitefoot .ext svg { width: 13px; height: 13px; fill: currentColor; }
  .sitefoot { margin: auto 0 0; padding-top: var(--s3); border-top: 1px solid var(--rule); font-size: 13px; color: var(--muted); text-align: center; }
  .sitefoot .foot-line { margin: 0; display: flex; flex-wrap: wrap; justify-content: center; align-items: center; }
  .sitefoot .foot-line > * { display: inline-flex; align-items: center; min-height: 36px; }
  .sitefoot .foot-line > * + *::before { content: '\00b7'; margin: 0 var(--s3); }
  @media (max-width: 479px) {
    /* Wrapped lines would start with a stray dot, so phones drop the dots and rely on the gap. */
    .sitefoot .foot-line { column-gap: var(--s4); }
    .sitefoot .foot-line > * + *::before { display: none; }
  }
  .sitefoot a { color: inherit; text-decoration: none; }
  .sitefoot a:hover { color: var(--accent); text-decoration: underline; }

  .tabbar {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 10;
    display: grid; grid-template-columns: repeat(var(--tabs, 4), 1fr);
    background: var(--surface); border-top: 1px solid var(--rule);
    padding-bottom: env(safe-area-inset-bottom);
  }
  .tabbar a {
    position: relative; white-space: nowrap; min-width: 0;
    display: flex; flex-direction: column; align-items: center; justify-content: flex-start;
    gap: 2px; min-height: var(--tabbar-h); padding-top: 8px;
    text-decoration: none; color: var(--muted);
    font-size: var(--fs-xs); line-height: 1.15; font-weight: 600; text-align: center;
  }
  .plan-badge {
    display: inline-block; min-width: 18px; height: 18px; padding: 0 6px; margin-left: 8px; vertical-align: middle;
    border-radius: 9px; background: var(--accent); color: var(--accent-ink);
    font-size: 13px; font-weight: 600; line-height: 18px; text-align: center;
  }
  .plan-badge[hidden] { display: none; }
  .tabbar .plan-badge { position: absolute; top: 6px; left: 50%; margin-left: 8px; }
  .tabbar a[aria-current='page'] { color: var(--accent); }
  /* Six tabs on a narrow phone: smaller labels on one line; the planner tab uses its short label here. */
  @media (max-width: 420px) { .tabbar a { font-size: 11px; } }

  @media (min-width: 768px) {
    .tabbar { display: none; }
    .desk-nav { display: flex; }
    .top-inner { justify-content: flex-start; column-gap: var(--s4); }
    .hdr-right { margin-left: 0; flex: 0 1 auto; }
    .winpick { flex: 0 1 auto; }
    .top-inner { flex-wrap: nowrap; }
    .desk-nav { gap: var(--s4); flex: none; }
    .winpick select { width: auto; max-width: 100%; font-size: 14px; padding-right: 40px; padding-left: 12px; background-position: right 12px center; }
    /* Below 1100px the pill can reach the centred footer text, so leave room under it. */
    main { padding-bottom: 72px; }
    .helpfab { width: auto; height: 40px; padding: 0 14px; right: calc(24px + env(safe-area-inset-right)); bottom: calc(24px + env(safe-area-inset-bottom)); }
    .helpfab span { display: inline; }
    .helpfab.on-home, .helpfab.on-planner { display: inline-flex; }
    body:has(.planner.has-bar) .helpfab { bottom: calc(24px + env(safe-area-inset-bottom)); }
  }
  /* Wide enough for all three: brand left, tabs centred on the page, window picker right. */
  @media (min-width: 1100px) {
    /* The pill sits far right of the centred footer: a small gap under the footer is enough. */
    main { padding-bottom: var(--s4); }
    .top-inner { display: grid; grid-template-columns: 1fr auto 1fr; }
    .desk-nav { justify-self: center; margin: 0; gap: var(--s5); }
    .hdr-right { justify-self: end; }
  }
</style>
