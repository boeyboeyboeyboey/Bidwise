---
import Base from '../layouts/Base.astro';
import WindowCard from '../components/home/WindowCard.svelte';
import Forecasts from '../components/home/Forecasts.svelte';
import Freed from '../components/home/Freed.svelte';
import { getWindow, getSchedule, windowLabel, formatWhen, dataMeta } from '../lib/data';
import { getFreedSeats, getForecastHighlights, getCourse } from '../lib/data/server';
import { formatSlot } from '../lib/format/slot';
import { FORECASTS_ENABLED } from '../lib/flags';

const hl = FORECASTS_ENABLED ? getForecastHighlights() : null;
const win = getWindow();
const windows = getSchedule().map((s) => ({
  label: windowLabel(s), opensAt: s.opensAt, closesAt: s.closesAt, opens: formatWhen(s.opensAt), closes: formatWhen(s.closesAt),
}));

// Day and time of each listed section, joined from the course files (the list data has none).
const courses = new Map<string, ReturnType<typeof getCourse>>();
const course = (code: string) => (courses.has(code) ? courses.get(code) : courses.set(code, getCourse(code)).get(code));
const slotOf = (code: string, section: string, classNumber?: string) => {
  const s = course(code)?.sectionsNow.find((x) => (classNumber ? x.classNumber === classNumber : x.section === section));
  return s ? formatSlot(s.meetings) : '';
};
const freed = getFreedSeats(6).map((r) => ({ ...r, slot: slotOf(r.code, r.section, r.classNumber) }));
const slots: Record<string, string> = {};
if (hl) {
  for (const w of Object.values(hl.byWindow)) {
    for (const h of w.mostContested.slice(0, 12)) slots[h.classNumber] = slotOf(h.code, h.section, h.classNumber);
  }
}
---
<Base title="This window · Bidwise">
  <div class="win">
    <h1>Hot sections &amp; freed seats</h1>
    <WindowCard
      client:load
      label={windowLabel(win)}
      closesLabel={formatWhen(win.closesAt)}
      closesAt={win.closesAt}
      status={win.status}
      windows={windows}
    />
    <div class="lists">
      {hl && <Forecasts client:load byWindow={hl.byWindow} openLabel={hl.window} targetP={hl.targetP} slots={slots} />}
      <Freed client:load rows={freed} openScanAt={dataMeta.seats?.openScanAt ?? null} scanAt={dataMeta.seats?.scanAt ?? null} />
    </div>
  </div>
</Base>

<style>
  .win { display: grid; gap: var(--s4); }
  h1 { font-size: var(--fs-xl); font-weight: 600; line-height: 1.15; }
  .lists { display: grid; gap: var(--s5); align-items: start; }
  @media (min-width: 1024px) {
    h1 { font-size: var(--fs-hero); }
    .lists { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--s6); }
  }
</style>
