---
import '../styles/global.css';
import { getWindow, getSchedule, windowLabel, getForecastMeta } from '../lib/data';
import { PLANNER_ENABLED } from '../lib/flags';
import { GITHUB_URL, LINKEDIN_URL, GITHUB_ICON, LINKEDIN_ICON } from '../lib/links';

interface Props {
  title?: string;
  active?: 'search' | 'classes' | 'explore' | 'planner' | 'schedule' | 'method';
  /** The header's bidding-window select; off on pages that don't use it. */
  windowPicker?: boolean;
}
const { title = 'Bidwise', active, windowPicker = true } = Astro.props;
const openLabel = windowLabel(getWindow());
const openStatus = getWindow().status;
// Read in the browser by lib/data/window.ts, which re-picks the window against the clock.
const winData = JSON.stringify({ schedule: getSchedule(), configured: getWindow() }).replace(/</g, '\\u003c');
const tagFor = (s: string) => (s === 'open' ? ' (open now)' : s === 'upcoming' ? ' (next)' : '');
const windows = getForecastMeta().windows;
const choices = windows.includes(openLabel) ? windows : [openLabel, ...windows];
const allTabs = [
  { id: 'search', href: '/', label: 'Courses', icon: 'M11 4a7 7 0 1 0 4.2 12.6l4.1 4.1 1.4-1.4-4.1-4.1A7 7 0 0 0 11 4Zm0 2a5 5 0 1 1 0 10 5 5 0 0 1 0-10Z' },
  { id: 'classes', href: '/classes/', label: 'Classes', icon: 'M4 5h2v2H4V5Zm4 0h12v2H8V5Zm-4 6h2v2H4v-2Zm4 0h12v2H8v-2Zm-4 6h2v2H4v-2Zm4 0h12v2H8v-2Z' },
  { id: 'explore', href: '/explore', label: 'Past bids', icon: 'M4 4h2v14h14v2H4V4Zm5 8h2v4H9v-4Zm4-4h2v8h-2V8Zm4 2h2v6h-2v-6Z' },
  { id: 'planner', href: '/planner', label: 'Bid planner', icon: 'M5 4h14a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1Zm1 2v12h12V6H6Zm2 2h8v2H8V8Zm0 4h8v2H8v-2Z' },
  { id: 'schedule', href: '/schedule/', label: 'Schedule', icon: 'M7 2h2v2h6V2h2v2h3a1 1 0 0 1 1 1v15a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h3V2Zm-2 6v11h14V8H5Zm2 2h4v4H7v-4Z' },
] as const;
const tabs = allTabs.filter((t) => PLANNER_ENABLED || t.id !== 'planner');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="top">
      <div class="top-inner">
        <a class="brand" href="/" aria-label="Bidwise home">Bidwise</a>
        <nav class="desk-nav" aria-label="Main">
          {tabs.map((t) => (
            <a href={t.href} aria-current={active === t.id ? 'page' : undefined}>{t.label}{t.id === 'planner' && <span class="plan-badge" hidden></span>}</a>
          ))}
        </nav>
        {windowPicker && (
        <label class="winpick"><span>Bidding window</span>
          <select id="win-pick" data-open={openLabel} aria-label="Bidding window">
            {choices.map((w) => <option value={w} selected={w === openLabel}>{w === openLabel ? `${w}${tagFor(openStatus)}` : w}</option>)}
          </select>
        </label>
        )}
      </div>
    </header>

    <main id="main" tabindex="-1">
      <slot />
      <footer class="sitefoot"><span>Not affiliated with SMU</span><span>Data: BOSS Overall Results, Nov 2026</span><a href="/method">How it works</a><a href="/contact">Contact</a>{LINKEDIN_URL && (<a class="ext" href={LINKEDIN_URL} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={LINKEDIN_ICON} /></svg>LinkedIn</a>)}{GITHUB_URL !== 'https://github.com/' && (<a class="ext" href={GITHUB_URL} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={GITHUB_ICON} /></svg>Source code</a>)}</footer>
    </main>

    <nav class="tabbar" aria-label="Main" style={`--tabs:${tabs.length}`}>
      {tabs.map((t) => (
        <a href={t.href} aria-current={active === t.id ? 'page' : undefined}>
          <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d={t.icon} fill="currentColor" fill-rule="evenodd" /></svg>
          <span>{t.label}</span>
          {t.id === 'planner' && <span class="plan-badge" hidden></span>}
        </a>
      ))}
    </nav>
    <script type="application/json" id="win-data" set:html={winData}></script>
    <script>
      import { getChosenWindow, setChosenWindow, onWindowChange } from '../lib/state';
      import { liveWindow } from '../lib/data/window';
      const pick = document.getElementById('win-pick') as HTMLSelectElement | null;
      if (pick) {
        // The default is the window that is open now, or the next to open; a stale page re-picks it from the clock.
        let open = pick.dataset.open ?? '';
        const live = liveWindow();
        if (live) {
          open = `Round ${live.round} Window ${live.window}`;
          if (![...pick.options].some((o) => o.value === open)) pick.add(new Option(open, open), pick.options[0]);
        }
        const tags = { open: ' (open now)', upcoming: ' (next)', closed: '' };
        if (live) for (const o of pick.options) o.textContent = o.value === open ? o.value + tags[live.status] : o.value;
        const has = (v: string | null): v is string => !!v && [...pick.options].some((o) => o.value === v);
        const show = (v: string | null) => { pick.value = has(v) ? v : open; };
        show(getChosenWindow());
        pick.addEventListener('change', () => setChosenWindow(pick.value === open ? null : pick.value));
        onWindowChange(show);
      }
    </script>
    <script is:inline>
      (function () {
        function count() {
          var n = 0;
          try {
            var st = JSON.parse(localStorage.getItem('boss.planner') || 'null');
            if (st && Array.isArray(st.r)) n += st.r.length;
          } catch (e) {}
          try {
            var l = JSON.parse(localStorage.getItem('boss.plan') || 'null');
            if (Array.isArray(l)) n += l.length;
          } catch (e) {}
          return n;
        }
        function update() {
          var n = count();
          document.querySelectorAll('.plan-badge').forEach(function (b) {
            b.textContent = String(n);
            b.hidden = n === 0;
            b.setAttribute('aria-hidden', 'true');
            var a = b.parentElement;
            if (a) {
              if (n === 0) a.removeAttribute('aria-label');
              else a.setAttribute('aria-label', 'Bid planner, ' + n + (n === 1 ? ' course' : ' courses'));
            }
          });
        }
        update();
        window.addEventListener('plan-change', update);
        window.addEventListener('storage', update);
      })();
    </script>
  </body>
</html>

<style is:global>
  .top {
    position: sticky; top: 0; z-index: 10;
    background: var(--bg);
    border-bottom: 1px solid var(--rule);
    padding-top: env(safe-area-inset-top);
  }
  .skip {
    position: absolute; left: var(--s2); top: var(--s2); z-index: 20;
    padding: var(--s3) var(--s4); font-weight: 600; text-decoration: none;
    color: var(--accent-ink); background: var(--accent); border-radius: var(--r-md);
    transform: translateY(-200%);
  }
  .skip:focus { transform: none; outline: 2px solid var(--focus); outline-offset: 2px; }
  main:focus { outline: none; }
  .top-inner {
    max-width: var(--maxw); margin: 0 auto;
    min-height: var(--topbar-h);
    padding: var(--s2) var(--gutter);
    display: flex; flex-wrap: wrap; align-items: center; gap: var(--s2);
    justify-content: space-between;
  }
  .brand { font-family: var(--font); font-weight: 700; font-size: 21px; letter-spacing: -0.035em; color: var(--accent); text-decoration: none; display: inline-flex; align-items: center; min-height: 44px; white-space: nowrap; }
  .winpick { display: flex; align-items: center; gap: var(--s2); font-size: 14px; color: var(--muted); min-width: 0; margin-left: auto; flex: 1 1 232px; }
  .winpick span { display: none; white-space: nowrap; }
  .winpick select { min-width: 0; width: 100%; height: 44px; font-size: 13px; padding-right: 32px; padding-left: 10px; background-position: right 8px center; text-overflow: ellipsis; }
  .desk-nav { display: none; gap: var(--s5); margin-left: auto; }
  .desk-nav a {
    text-decoration: none; color: var(--muted); font-weight: 600;
    display: inline-flex; align-items: center; min-height: 44px; border-bottom: 2px solid transparent;
  }
  .desk-nav a:hover { color: var(--text); }
  .desk-nav a[aria-current='page'] { color: var(--accent); border-bottom-color: var(--accent); }

  body { min-height: calc(100dvh / var(--z)); display: flex; flex-direction: column; }
  main {
    flex: 1; width: 100%; display: flex; flex-direction: column;
    max-width: var(--maxw); margin: 0 auto;
    padding: var(--s5) var(--gutter) calc(var(--tabbar-h) + var(--s7) + env(safe-area-inset-bottom));
  }
  main > :nth-last-child(2) { margin-bottom: var(--s6); }
  .sitefoot .ext { white-space: nowrap; display: inline-flex; align-items: center; gap: 4px; }
  .sitefoot .ext svg { width: 13px; height: 13px; fill: currentColor; }
  .sitefoot { margin: auto 0 0; padding-top: var(--s2); border-top: 1px solid var(--rule); font-size: 13px; color: var(--muted); display: flex; flex-wrap: wrap; align-items: center; column-gap: var(--s5); }
  .sitefoot > * { display: inline-flex; align-items: center; min-height: 44px; }

  .tabbar {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 10;
    display: grid; grid-template-columns: repeat(var(--tabs, 4), 1fr);
    background: var(--surface); border-top: 1px solid var(--rule);
    padding-bottom: env(safe-area-inset-bottom);
  }
  .tabbar a {
    position: relative; white-space: nowrap; min-width: 0;
    display: flex; flex-direction: column; align-items: center; justify-content: flex-start;
    gap: 2px; min-height: var(--tabbar-h); padding-top: 8px;
    text-decoration: none; color: var(--muted);
    font-size: var(--fs-xs); line-height: 1.15; font-weight: 600; text-align: center;
  }
  .plan-badge {
    display: inline-block; min-width: 18px; height: 18px; padding: 0 6px; margin-left: 8px; vertical-align: middle;
    border-radius: 9px; background: var(--accent); color: var(--accent-ink);
    font-size: 13px; font-weight: 600; line-height: 18px; text-align: center;
  }
  .plan-badge[hidden] { display: none; }
  .tabbar .plan-badge { position: absolute; top: 6px; left: 50%; margin-left: 8px; }
  .tabbar a[aria-current='page'] { color: var(--accent); }

  @media (min-width: 768px) {
    .tabbar { display: none; }
    .desk-nav { display: flex; }
    .top-inner { justify-content: flex-start; column-gap: var(--s4); }
    .winpick { margin-left: 0; flex: 0 1 auto; }
    .winpick select { width: auto; max-width: 100%; font-size: 14px; padding-right: 40px; padding-left: 12px; background-position: right 12px center; }
    .winpick span { display: inline; }
    main { padding-bottom: var(--s7); }
  }
</style>
