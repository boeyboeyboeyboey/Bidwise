---
import Base from '../../../layouts/Base.astro';
import HistoryView from '../../../components/course/HistoryView.svelte';
import TermSections from '../../../components/course/TermSections.svelte';
import { getCourseIndex, getWindow, windowLabel } from '../../../lib/data';
import { getCourse } from '../../../lib/data/server';
import { historySeed } from '../../../components/course/history';
import { courseDataset, courseDescription, courseFacts } from '../../../lib/courseFacts';

export function getStaticPaths() {
  return getCourseIndex().map((c) => ({ params: { code: c.code } }));
}

const course = getCourse(Astro.params.code!)!;
const facts = courseFacts(course.history);
const description = courseDescription(course.code, course.title, facts, 'history');
const pageUrl = new URL(`/course/${course.code}/history/`, Astro.site).href;
const instructor = course.sectionsNow[0]?.instructor ?? null;
const windowName = windowLabel(getWindow());
const seed = historySeed(course.history, instructor, windowName) ?? undefined;
---
<Base title={`${course.code} past results · Bidwise`} description={description} jsonLd={facts ? [courseDataset(course.code, course.title, description, pageUrl, facts, `${Astro.site}`)] : []} active="search">
  <a class="back" href={`/course/${course.code}`}>‹ {course.code}</a>
  <header>
    <h1>Past results</h1>
    <p>{course.code} {course.title}</p>
    <a class="jump" href="#by-term">By term ↓</a>
  </header>
  <HistoryView client:load code={course.code} {windowName} {seed} {instructor} />
  <TermSections client:load code={course.code} />
</Base>

<style>
  .back { display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; font-size: 15px; color: var(--accent); text-decoration: none; }
  header { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 var(--s3); padding-bottom: var(--s3); }
  h1 { font-size: 30px; font-weight: 600; }
  p { margin: 0; color: var(--muted); font-size: 17px; }
  .jump { margin-left: auto; font-weight: 600; font-size: 15px; color: var(--accent); }
  /* No past-term block for this course (or not loaded yet): no link to it. */
  :global(body:not(:has(#by-term))) .jump { display: none; }
</style>
